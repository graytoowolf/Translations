#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:20
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "Getting authorization to access %1 services."
msgstr "Autorisierung um auf %1 Dienste zuzugreifen wird geladen."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:67
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "Failed to get authorization for %1 services. Error %2."
msgstr "Autorisierung für %1 fehlgeschlagen. Fehler %2."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:77
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "Could not parse authorization response for access to %1 services."
msgstr "Autorisierungs-Antwort konnte für den Zugriff auf %1 Dienste nicht verarbeitet werden."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:85
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "Server has changed %1 authorization user hash in the reply. Something is wrong."
msgstr "Server hat den %1 Autorisierungsnutzer-Hash in der Antwort geändert. Irgendetwas stimmt nicht."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:92
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "Got authorization to access %1"
msgstr "Autorisierung für %1 erhalten"

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:108
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "Cannot parse %1 authorization error response as JSON: %2"
msgstr "Kann %1 Autorisierungsfehler nicht als JSON verarbeiten: %2"

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:118
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "XErr element is missing from %1 authorization error response."
msgstr "XErr Element fehlt in der %1 Autorisierungsfehler-Antwort."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:127
msgctxt "XboxAuthorizationStep|"
msgid "Your XBox Live account has been banned by Microsoft for violating the XBox Community Standards.\n"
"This may happen if your account was shared or resold."
msgstr "Ihr XBox Live-Konto wurde von Microsoft wegen Verletzung der XBox Community-Standards gesperrt.\n"
"Dies kann passieren, wenn Ihr Konto freigegeben oder verkauft wurde."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:134
msgctxt "XboxAuthorizationStep|"
msgid "This Microsoft account is linked to a family and your parent or guardian has not given you permission to play online."
msgstr "Dieses Microsoft-Konto ist mit einer Familie verbunden und Ihre Eltern oder Erziehungsberechtigte haben Ihnen nicht die Erlaubnis gegeben, online zu spielen."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:141
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "This Microsoft account does not have an XBox Live profile. Buy the game on %1 first."
msgstr "Dieses Microsoft Konto hat kein Xbox Live Profil. Kaufe zuerst das Spiel auf %1."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:149
msgctxt "XboxAuthorizationStep|"
msgid "This account has not accepted the XBox Terms of Service. Please log in online and accept them."
msgstr "Dieses Konto hat die XBox Nutzungsbedingungen nicht akzeptiert. Bitte melden Sie sich online an und akzeptieren sie."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:157
msgctxt "XboxAuthorizationStep|"
msgid "XBox Live is not available in your country. You've been blocked."
msgstr "Xbox Live ist in deinem Land nicht verfügbar. Du wurdest blockiert."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:164
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "This Microsoft account requires proof of age to play. Please login to %1 to provide proof of age."
msgstr "Für dieses Microsoft-Konto ist ein Altersnachweis erforderlich. Bitte melde dich bei %1 an, um einen Altersnachweis zu erbringen."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:172
msgctxt "XboxAuthorizationStep|"
msgid "This Microsoft account has reached its playtime limit and has been blocked from logging in."
msgstr "Dieses Microsoft-Konto hat sein Spielzeitlimit erreicht und wurde vom Anmelden blockiert."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:179
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "This Microsoft account is underaged and is not linked to a family.\n\n"
"Please set up your account according to %1."
msgstr "Dieses Microsoft-Konto ist minderjährig und ist nicht mit einer Familie verknüpft.\n\n"
"Bitte richte dein Konto gemäß %1 ein."

#: src/launcher/minecraft/auth/steps/XboxAuthorizationStep.cpp:187
#, qt-format
msgctxt "XboxAuthorizationStep|"
msgid "XSTS authentication ended with unrecognized error(s):\n\n"
"%1"
msgstr "XSTS-Authentifizierung endete mit unbekannten Fehlern:\n\n"
"%1"

